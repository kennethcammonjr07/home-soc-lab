local.file_match "soc_logs" {
  path_targets = [
    {"__path__" = "/host/suricata/eve.json", "job" = "suricata"},
    {"__path__" = "/host/pihole/pihole.log", "job" = "pihole"},
    {"__path__" = "/host/cowrie/log/cowrie/cowrie.json", "job" = "cowrie"},
  ]
}

loki.source.file "soc_logs" {
  targets    = local.file_match.soc_logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
